{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joppo",
  // Not .open-next/worker.js directly. That file exports `fetch` only, and a
  // cron trigger invokes `scheduled()`, so the hourly crawl silently never ran.
  // worker-entry.js wraps it and adds that handler.
  "main": "worker-entry.js",
  "compatibility_date": "2026-09-01",
  // nodejs_compat gives the Worker the Node APIs the Postgres driver and
  // Next's server need. Without it the build runs but the app cannot connect.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Read by src/lib/db.ts to pick the Postgres driver over Prisma's native
  // engine. A build-time flag rather than runtime sniffing, because the Node
  // compatibility layer makes a Worker look enough like Node to fool a guess.
  "vars": {
    "RUNTIME_TARGET": "cloudflare"
  },
  // No cron trigger, deliberately.
  //
  // The crawl cannot run inside a Worker on the free plan: 10ms of CPU per
  // invocation, and parsing a single job board is well past that, so even
  // ?limit=1 dies with error 1102 after writing part of a source. A scheduled
  // invocation hits the same ceiling, so an hourly trigger here would only
  // half-crawl a source and fail, once an hour, silently.
  //
  // The crawl runs in .github/workflows/crawl.yml instead, in a plain Node
  // runner with no CPU cap, writing to Supabase directly.
  //
  // worker-entry.js still exports the scheduled() handler OpenNext omits. On
  // Workers Paid, where the CPU limit is 30s, restoring the line below is all
  // that is needed to move the crawl back here:
  //   "triggers": { "crons": ["17 * * * *"] }
  "triggers": {
    "crons": []
  }
}
