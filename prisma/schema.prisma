// Joppo data model.
// Provider is sqlite so the app runs with zero infrastructure.
// To move to Postgres: change provider to "postgresql", point DATABASE_URL at it,
// then run `npx prisma db push`. No application code changes are required.

generator client {
  provider = "prisma-client-js"
  // Cloudflare Workers run in V8 isolates and cannot load Prisma's native
  // query engine binary, so queries go through a JavaScript driver instead.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  // Queries go through the Supabase transaction pooler on 6543.
  url      = env("DATABASE_URL")
  // Migrations need a direct connection; they cannot run through a pooler.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- auth

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  subscription  Subscription?
  saved         SavedListing[]
  savedSearches SavedSearch[]
  payments      Payment[]

  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------- onboarding

// Answers collected before the paywall. Drives the personalised match count
// that is shown at the moment of the ask, and the default search filters.
model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  situation        String? // urgency bucket
  categories       String   @default("[\"JOB\"]") // JSON array of Category
  roles            String   @default("[]")        // JSON array of free-text role/keyword
  seniority        String?
  locations        String   @default("[]")        // JSON array
  remoteOnly       Boolean  @default(false)
  minSalary        Int?
  matchCount       Int      @default(0)
  completedAt      DateTime?
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------- billing

model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  plan              String // WEEKLY | MONTHLY | YEARLY
  status            String    @default("inactive") // active | inactive | cancelled | past_due
  currentPeriodEnd  DateTime?
  paystackRef       String?
  paystackCustomer  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
  @@index([currentPeriodEnd])
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  reference   String   @unique
  plan        String
  amount      Int // minor units
  currency    String
  status      String // pending | success | failed
  rawEvent    String? // JSON blob from the webhook, kept for reconciliation
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------- catalogue

model Company {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  domain    String?
  logoUrl   String?
  industry  String?
  location  String?
  source    String?
  createdAt DateTime @default(now())

  listings Listing[]

  @@index([name])
}

// One row per opportunity, whatever the category.
// Jobs, grants, partnerships, investment calls and freelance contracts all
// share this shape; category-specific fields are nullable.
model Listing {
  id          String @id @default(cuid())
  externalId  String
  source      String // greenhouse | lever | ashby | workable | smartrecruiters | recruitee | grantsgov | remotive | remoteok | jsonld | manual
  category    String // JOB | GRANT | PARTNERSHIP | INVESTMENT | CONTRACT

  title       String
  description String  @default("")
  applyUrl    String

  companyId   String?
  companyName String? // denormalised for sources with no company record

  locations      String  @default("[]") // JSON array
  remote         Boolean @default(false)
  workArrangement String? // Remote | Hybrid | On-site
  employmentType String? // FULL_TIME | PART_TIME | CONTRACT | INTERNSHIP | TEMPORARY
  seniority      String? // 0-2 | 2-5 | 5-10 | 10+
  tags           String  @default("[]") // JSON array of skills / focus areas

  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?

  // grant / investment / contract specifics
  amountMin      Int?
  amountMax      Int?
  amountCurrency String?
  deadline       DateTime?
  funder         String?

  postedAt   DateTime  @default(now())
  fetchedAt  DateTime  @default(now())
  active     Boolean   @default(true)
  // When active flipped to false, so long-dead rows can be purged.
  retiredAt  DateTime?

  // Which board this came from. Lets a crawl retire exactly the listings that
  // disappeared from that board, instead of ageing every listing out globally.
  sourceId   String?

  company    Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  sourceRef  Source?        @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  saved      SavedListing[]

  @@unique([source, externalId])
  @@index([sourceId, fetchedAt])
  @@index([active, retiredAt])
  @@index([category, postedAt])
  @@index([remote])
  @@index([active, category])
}

// A named set of filters the user can re-run with one click.
model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filters   String   @default("{}") // JSON blob of the search input
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

// Rate limiting and plan quotas.
//
// One row per (key, window). A key is an IP for anonymous callers or a user id
// for signed-in ones; a window is an hour bucket for burst control or a month
// bucket for plan quotas. Counting in the database rather than in memory is
// what makes the limit hold across serverless instances, which each have their
// own memory and are created and destroyed constantly.
model Usage {
  id        String   @id @default(cuid())
  key       String
  window    String
  count     Int      @default(0)
  expiresAt DateTime

  @@unique([key, window])
  @@index([expiresAt])
}

// Where the crawler goes. Editable from seed data so new sources do not
// require a code change.
model Source {
  id        String   @id @default(cuid())
  kind      String // greenhouse | lever | ashby | workable | smartrecruiters | recruitee | jsonld | grantsgov | remotive | remoteok
  token     String // board token, company slug, or full URL for jsonld
  label     String?
  category  String   @default("JOB")
  enabled   Boolean  @default(true)
  lastRunAt DateTime?
  lastCount Int      @default(0)
  lastError String?

  listings Listing[]

  @@unique([kind, token])
}

/// A periodic reading of the numbers that cannot be reconstructed after the
/// fact. Signups and revenue can always be recounted from their own timestamps,
/// but database size and catalogue size have no history of their own, so
/// "how fast is this growing, and when does it run out" is unanswerable without
/// writing it down. One row per crawl, which is a handful of rows a day.
model Snapshot {
  id         String   @id @default(cuid())
  takenAt    DateTime @default(now())
  dbBytes    BigInt
  listings   Int
  users      Int
  activeSubs Int
  grossMinor Int

  @@index([takenAt])
}
