# ---------- Database ----------
DATABASE_URL="file:./dev.db"

# ---------- NextAuth ----------
NEXTAUTH_URL="http://localhost:3100"
NEXTAUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# Google OAuth (console.cloud.google.com -> Credentials -> OAuth client ID -> Web)
# Authorised redirect URI: http://localhost:3100/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Magic-link email. Leave EMAIL_SERVER blank in dev and the link is printed
# to the terminal instead of being posted to an SMTP server.
EMAIL_SERVER=""
EMAIL_FROM="Joppo <login@joppo.app>"

# ---------- Paystack ----------
# dashboard.paystack.com -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
# Webhook URL to register: https://your-domain/api/paystack/webhook
PAYSTACK_CURRENCY="USD"

# Set to "1" to let checkout succeed without real Paystack keys (local testing only)
BILLING_DEV_BYPASS="1"

# ---------- Ingestion ----------
INGEST_USER_AGENT="JoppoBot/0.1 (+https://joppo.app/bot)"
INGEST_CONCURRENCY="4"

# ---------- Scheduled crawl ----------
# Protects /api/cron/ingest. Vercel sends it as a bearer token automatically
# once this is set as a project environment variable.
CRON_SECRET=""
# Sources crawled per hourly run. Raise it as the source list grows.
INGEST_BATCH="10"
