{
  "name": "joppo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "opennextjs-cloudflare build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "tsx src/scrapers/run.ts --seed",
    "ingest": "tsx src/scrapers/run.ts",
    "ingest:jobs": "tsx src/scrapers/run.ts --only=JOB",
    "ingest:grants": "tsx src/scrapers/run.ts --only=GRANT",
    "db:indexes": "node scripts/apply-indexes.mjs",
    "discover": "tsx src/scrapers/discover-cli.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:deploy": "prisma db push --skip-generate && node scripts/apply-indexes.mjs",
    "build:next": "prisma generate && next build"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/adapter-pg-worker": "^5.22.0",
    "@prisma/client": "5.22.0",
    "@prisma/pg-worker": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "lucide-react": "0.454.0",
    "next": "^15.5.25",
    "next-auth": "4.24.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "2.5.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "20.17.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.28",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.14",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "esbuild": "^0.25.12"
  }
}
